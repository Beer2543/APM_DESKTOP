<!doctype html>
<html lang="th"><head><script src="/_sdk/telemetry_sdk.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบบันทึกสต็อกน้ำมัน SUSCO</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    .tab-active { border-bottom: 3px solid #7c9cbf; color: #4a7a9b; font-weight: 600; }
    .bar { transition: height 0.3s ease; }
  </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="min-h-screen" style="background: rgb(245, 240, 255);"><!-- Banner -->
  <div class="w-full overflow-hidden" style="max-height:80px;"><img data-template-id="banner-img" class="canva-image w-full h-20 object-cover" loading="lazy" src="canva://MAHM9YoB5g4/1" alt="SUSCO Senanikom banner">
  </div>
  <header data-template-id="header-section" class="canva-header shadow-sm sticky top-0 z-50" style="background: rgba(255, 255, 255, 0.933);">
   <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-3"><img data-template-id="logo-img" class="canva-image w-10 h-10 rounded-lg object-contain" loading="lazy" src="canva://MAHM9doltVw/1" alt="โลโก้ SUSCO ซัสโก้">
    <h1 data-template-id="app-title" class="canva-text font-bold text-lg flex-1" style="color: rgb(59, 74, 107); font-weight: 700; font-style: normal; font-size: 20px;">ระบบบันทึกสต็อกน้ำมัน SUSCO</h1><span id="current-date" class="text-sm opacity-70"></span>
   </div>
   <nav class="max-w-7xl mx-auto px-4 flex gap-1 overflow-x-auto"><button onclick="showTab('dashboard')" id="tab-dashboard" class="tab-active px-4 py-2 text-sm font-medium whitespace-nowrap">Dashboard</button> <button onclick="showTab('add')" id="tab-add" class="px-4 py-2 text-sm font-medium whitespace-nowrap">เพิ่มข้อมูล</button> <button onclick="showTab('list')" id="tab-list" class="px-4 py-2 text-sm font-medium whitespace-nowrap">รายการ</button> <button onclick="showTab('price')" id="tab-price" class="px-4 py-2 text-sm font-medium whitespace-nowrap">ราคาน้ำมัน</button>
   </nav>
  </header>
  <main class="max-w-7xl mx-auto p-4"><!-- Dashboard -->
   <section id="page-dashboard">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
     <div data-template-id="card-total-stock" class="canva-card rounded-2xl p-5 shadow-sm" style="background: rgb(224, 242, 254);">
      <p class="text-sm opacity-70">สต็อกรวม (ลิตร)</p>
      <p id="total-stock" class="text-2xl font-bold mt-1">0</p>
     </div>
     <div data-template-id="card-total-value" class="canva-card rounded-2xl p-5 shadow-sm" style="background: rgb(254, 243, 199);">
      <p class="text-sm opacity-70">มูลค่ารวม (บาท)</p>
      <p id="total-value" class="text-2xl font-bold mt-1">0</p>
     </div>
     <div data-template-id="card-branch-count" class="canva-card rounded-2xl p-5 shadow-sm" style="background: rgb(237, 233, 254);">
      <p class="text-sm opacity-70">สาขาที่รายงาน</p>
      <p id="branch-count" class="text-2xl font-bold mt-1">0</p>
     </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-4">
     <div data-template-id="chart-fuel-card" class="canva-card rounded-2xl p-5 shadow-sm" style="background: rgb(255, 255, 255);">
      <h3 class="font-semibold mb-3">ปริมาณน้ำมันแต่ละชนิด</h3>
      <div id="chart-fuel" class="flex items-end gap-2 h-48"></div>
     </div>
     <div data-template-id="chart-branch-card" class="canva-card rounded-2xl p-5 shadow-sm" style="background: rgb(255, 255, 255);">
      <h3 class="font-semibold mb-3">เปรียบเทียบรายสาขา</h3>
      <div id="chart-branch" class="flex items-end gap-1 h-48 overflow-x-auto"></div>
     </div>
    </div><!-- Mascot -->
    <div class="flex justify-center mt-4"><img data-template-id="mascot-img" class="canva-image w-28 h-28 object-contain rounded-2xl" loading="lazy" src="canva://MAHM9YuHwn0/1" alt="SUSCO mascot character">
    </div>
    <p id="last-update" class="text-sm opacity-60 text-right mt-2"></p>
   </section><!-- Add Data -->
   <section id="page-add" class="hidden">
    <div data-template-id="form-card" class="canva-card rounded-2xl p-6 shadow-sm max-w-2xl mx-auto" style="background: rgb(255, 255, 255);">
     <h2 data-template-id="form-title" class="canva-text font-bold text-xl mb-4" style="color: rgb(59, 74, 107); font-weight: 700; font-style: normal; font-size: 23px;">เพิ่มข้อมูลสต็อก</h2>
     <form id="add-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
       <div>
        <label for="input-date" class="block text-sm font-medium mb-1">วันที่</label><input type="date" id="input-date" required="" class="w-full border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-200">
       </div>
       <div>
        <label for="input-branch" class="block text-sm font-medium mb-1">สาขา</label><select id="input-branch" required="" class="w-full border border-gray-200 rounded-xl px-3 py-2"><option value="">-- เลือกสาขา --</option></select>
       </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="fuel-inputs"></div>
      <div class="flex gap-3"><button data-template-id="save-btn" type="submit" class="canva-button px-6 py-2 rounded-xl font-medium" style="background: rgb(147, 197, 253); color: rgb(30, 58, 95); font-weight: 600; font-style: normal; font-size: 15px;">บันทึก</button> <button type="button" onclick="resetForm()" class="px-6 py-2 rounded-xl border border-gray-200">ล้างข้อมูล</button>
      </div>
      <div id="form-msg" class="text-sm hidden"></div>
     </form>
    </div>
   </section><!-- Data List -->
   <section id="page-list" class="hidden">
    <div data-template-id="list-card" class="canva-card rounded-2xl p-6 shadow-sm" style="background: rgb(255, 255, 255);">
     <div class="flex flex-wrap gap-3 mb-4"><input type="date" id="filter-date" class="border border-gray-200 rounded-xl px-3 py-2 text-sm"> <select id="filter-branch" class="border border-gray-200 rounded-xl px-3 py-2 text-sm"><option value="">ทุกสาขา</option></select> <button onclick="exportCSV()" data-template-id="export-btn" class="canva-button ml-auto px-4 py-2 rounded-xl text-sm font-medium" style="background: rgb(134, 239, 172); color: rgb(20, 83, 45); font-weight: 600; font-style: normal; font-size: 15px;">Export CSV</button>
     </div>
     <div class="overflow-x-auto">
      <table class="w-full text-sm">
       <thead>
        <tr class="border-b text-left">
         <th class="py-2 px-2">วันที่</th>
         <th class="py-2 px-2">สาขา</th>
         <th class="py-2 px-1">B7</th>
         <th class="py-2 px-1">เบนซิน</th>
         <th class="py-2 px-1">GSH91</th>
         <th class="py-2 px-1">GSH95</th>
         <th class="py-2 px-1">E20</th>
         <th class="py-2 px-1">HI-PADD</th>
         <th class="py-2 px-1">HI-PG97</th>
         <th class="py-2 px-1">B20</th>
         <th class="py-2 px-2">จัดการ</th>
        </tr>
       </thead>
       <tbody id="data-table"></tbody>
      </table>
     </div>
     <p id="no-data-msg" class="text-center py-8 opacity-50 hidden">ไม่มีข้อมูล</p>
    </div>
   </section><!-- Price -->
   <section id="page-price" class="hidden">
    <div data-template-id="price-card" class="canva-card rounded-2xl p-6 shadow-sm max-w-2xl mx-auto" style="background: rgb(255, 255, 255);">
     <h2 data-template-id="price-title" class="canva-text font-bold text-xl mb-4" style="color: rgb(59, 74, 107); font-weight: 700; font-style: normal; font-size: 23px;">ราคาน้ำมันปัจจุบัน (บาท/ลิตร)</h2>
     <div id="price-inputs" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4"></div><button onclick="savePrices()" data-template-id="update-price-btn" class="canva-button px-6 py-2 rounded-xl font-medium" style="background: rgb(196, 181, 253); color: rgb(59, 31, 122); font-weight: 600; font-style: normal; font-size: 15px;">อัปเดตราคา</button>
     <p id="price-msg" class="text-sm mt-2 text-green-600 hidden">บันทึกราคาแล้ว</p>
    </div>
   </section>
  </main><!-- Edit Modal -->
  <div id="edit-modal" class="fixed inset-0 bg-black/40 z-50 hidden flex items-center justify-center p-4">
   <div class="bg-white rounded-2xl p-6 w-full max-w-lg max-h-[80vh] overflow-y-auto shadow-xl">
    <h3 class="font-bold text-lg mb-4">แก้ไขข้อมูล</h3>
    <form id="edit-form" class="space-y-3">
     <div class="grid grid-cols-2 gap-3">
      <div>
       <label class="text-sm">วันที่</label><input type="date" id="edit-date" class="w-full border rounded-xl px-2 py-1">
      </div>
      <div>
       <label class="text-sm">สาขา</label><select id="edit-branch" class="w-full border rounded-xl px-2 py-1"></select>
      </div>
     </div>
     <div id="edit-fuel-inputs" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
     <div class="flex gap-3 pt-2"><button type="submit" class="px-5 py-2 bg-sky-400 text-white rounded-xl">บันทึก</button> <button type="button" onclick="closeEditModal()" class="px-5 py-2 border rounded-xl">ยกเลิก</button>
     </div>
    </form>
   </div>
  </div><!-- Delete Confirm -->
  <div id="delete-modal" class="fixed inset-0 bg-black/40 z-50 hidden flex items-center justify-center p-4">
   <div class="bg-white rounded-2xl p-6 w-full max-w-sm text-center shadow-xl">
    <p class="mb-4 font-medium">ยืนยันลบข้อมูลนี้?</p>
    <div class="flex gap-3 justify-center"><button onclick="confirmDelete()" class="px-5 py-2 bg-red-400 text-white rounded-xl">ลบ</button> <button onclick="closeDeleteModal()" class="px-5 py-2 border rounded-xl">ยกเลิก</button>
    </div>
   </div>
  </div>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <script>
    const BRANCHES = ['ติวานนท์','ประชาราษฎร์','บางกร่าง','บางคูวัด','บางบัวทอง (ไทรน้อย)','ไฮเวย์ 340','บางพูด (วัดกู้)','ปากเกร็ด','ลาดปลาเค้า','ลาดหลุมแก้ว','วังหิน','วิภาวดี 1','เสนานิคม','มหาสวัสดิ์'];
    const FUELS = [{key:'b7',label:'B7'},{key:'benzin',label:'เบนซิน'},{key:'gsh91',label:'GSH91'},{key:'gsh95',label:'GSH95'},{key:'e20',label:'E20'},{key:'hi_padd',label:'HI-PADD'},{key:'hi_pg97',label:'HI-PG97'},{key:'b20',label:'B20'}];
    const COLORS = ['#93c5fd','#fcd34d','#86efac','#c4b5fd','#fca5a5','#f9a8d4','#67e8f9','#bef264'];

    let allData = [];
    let editingRecord = null;
    let deletingRecord = null;

    function getPrices() {
      const d = localStorage.getItem('fuel_prices');
      return d ? JSON.parse(d) : {b7:29.94,benzin:36.08,gsh91:36.08,gsh95:44.36,e20:33.44,hi_padd:32.44,hi_pg97:46.49,b20:29.94};
    }
    function savePrices() {
      const p = {};
      FUELS.forEach(f => { p[f.key] = parseFloat(document.getElementById('price-'+f.key).value)||0; });
      localStorage.setItem('fuel_prices', JSON.stringify(p));
      document.getElementById('price-msg').classList.remove('hidden');
      setTimeout(()=>document.getElementById('price-msg').classList.add('hidden'),2000);
      updateDashboard();
    }

    function populateBranches(sel) {
      BRANCHES.forEach(b => { const o = document.createElement('option'); o.value=b; o.textContent=b; sel.appendChild(o); });
    }
    populateBranches(document.getElementById('input-branch'));
    populateBranches(document.getElementById('filter-branch'));
    populateBranches(document.getElementById('edit-branch'));

    function createFuelInputs(container, prefix) {
      container.innerHTML = '';
      FUELS.forEach(f => {
        container.innerHTML += `<div><label class="text-xs font-medium">${f.label}</label><input type="number" id="${prefix}-${f.key}" min="0" step="1" class="w-full border border-gray-200 rounded-xl px-2 py-1 text-sm" value="0"></div>`;
      });
    }
    createFuelInputs(document.getElementById('fuel-inputs'),'fuel');
    createFuelInputs(document.getElementById('edit-fuel-inputs'),'edit-fuel');

    (function(){
      const c = document.getElementById('price-inputs'); const prices = getPrices();
      FUELS.forEach(f => {
        c.innerHTML += `<div><label class="text-xs font-medium">${f.label}</label><input type="number" id="price-${f.key}" step="0.01" class="w-full border border-gray-200 rounded-xl px-2 py-1 text-sm" value="${prices[f.key]||0}"></div>`;
      });
    })();

    document.getElementById('input-date').value = new Date().toISOString().slice(0,10);
    document.getElementById('current-date').textContent = new Date().toLocaleDateString('th-TH',{dateStyle:'long'});

    function showTab(name) {
      ['dashboard','add','list','price'].forEach(t => {
        document.getElementById('page-'+t).classList.toggle('hidden', t!==name);
        document.getElementById('tab-'+t).classList.toggle('tab-active', t===name);
      });
      if(name==='list') renderTable();
      if(name==='dashboard') updateDashboard();
    }

    const handler = { onDataChanged(data) { allData = data; updateDashboard(); renderTable(); } };
    (async()=>{ await window.dataSdk.init(handler); })();

    document.getElementById('add-form').addEventListener('submit', async(e)=>{
      e.preventDefault();
      if(allData.length>=999){showMsg('form-msg','⚠️ ถึงขีดจำกัด 999 รายการแล้ว','text-red-500');return;}
      const rec = { date: document.getElementById('input-date').value, branch: document.getElementById('input-branch').value };
      FUELS.forEach(f=>{ rec[f.key] = parseFloat(document.getElementById('fuel-'+f.key).value)||0; });
      const btn = document.querySelector('#add-form button[type=submit]');
      btn.disabled=true; btn.textContent='กำลังบันทึก...';
      const r = await window.dataSdk.create(rec);
      btn.disabled=false; btn.textContent='บันทึก';
      if(r.isOk){showMsg('form-msg','✓ บันทึกสำเร็จ','text-green-600');resetForm();}
      else showMsg('form-msg','เกิดข้อผิดพลาด','text-red-500');
    });

    function showMsg(id,msg,cls){const el=document.getElementById(id);el.textContent=msg;el.className='text-sm '+cls;el.classList.remove('hidden');setTimeout(()=>el.classList.add('hidden'),3000);}
    function resetForm(){FUELS.forEach(f=>{document.getElementById('fuel-'+f.key).value='0';});document.getElementById('input-branch').value='';}

    function updateDashboard() {
      const prices = getPrices();
      let totalStock=0, totalValue=0; const branchSet=new Set(); const fuelTotals={};
      FUELS.forEach(f=>fuelTotals[f.key]=0);
      const branchTotals={};
      allData.forEach(r=>{
        branchSet.add(r.branch);
        FUELS.forEach(f=>{const v=Number(r[f.key])||0; fuelTotals[f.key]+=v; totalStock+=v; totalValue+=v*(prices[f.key]||0);
          if(!branchTotals[r.branch])branchTotals[r.branch]=0; branchTotals[r.branch]+=v;});
      });
      document.getElementById('total-stock').textContent=totalStock.toLocaleString('th-TH');
      document.getElementById('total-value').textContent=totalValue.toLocaleString('th-TH',{minimumFractionDigits:2});
      document.getElementById('branch-count').textContent=branchSet.size;
      if(allData.length){const dates=allData.map(r=>r.date).sort();document.getElementById('last-update').textContent='อัปเดตล่าสุด: '+dates[dates.length-1];}

      const maxF = Math.max(...Object.values(fuelTotals),1);
      document.getElementById('chart-fuel').innerHTML = FUELS.map((f,i)=>`<div class="flex flex-col items-center flex-1"><div class="bar w-full rounded-t" style="height:${(fuelTotals[f.key]/maxF)*100}%;background:${COLORS[i]}"></div><span class="text-[10px] mt-1 text-center leading-tight">${f.label}</span></div>`).join('');

      const maxB = Math.max(...Object.values(branchTotals),1);
      const bKeys = Object.keys(branchTotals);
      document.getElementById('chart-branch').innerHTML = bKeys.map((b,i)=>`<div class="flex flex-col items-center" style="min-width:28px"><div class="bar w-5 rounded-t" style="height:${(branchTotals[b]/maxB)*100}%;background:${COLORS[i%8]}"></div><span class="text-[8px] mt-1 text-center leading-tight truncate w-8">${b.slice(0,4)}</span></div>`).join('');
    }

    function renderTable(){
      const fd=document.getElementById('filter-date').value;
      const fb=document.getElementById('filter-branch').value;
      let filtered=allData.filter(r=>{if(fd&&r.date!==fd)return false;if(fb&&r.branch!==fb)return false;return true;});
      const tbody=document.getElementById('data-table');
      const noMsg=document.getElementById('no-data-msg');
      if(!filtered.length){tbody.innerHTML='';noMsg.classList.remove('hidden');return;}
      noMsg.classList.add('hidden');
      tbody.innerHTML=filtered.map(r=>`<tr class="border-b hover:bg-sky-50/50"><td class="py-2 px-2 whitespace-nowrap">${r.date}</td><td class="py-2 px-2 whitespace-nowrap">${r.branch}</td>${FUELS.map(f=>`<td class="py-2 px-1">${Number(r[f.key])||0}</td>`).join('')}<td class="py-2 px-2 whitespace-nowrap"><button onclick='openEdit("${r.__backendId}")' class="text-sky-500 mr-2 text-xs">แก้ไข</button><button onclick='openDelete("${r.__backendId}")' class="text-red-400 text-xs">ลบ</button></td></tr>`).join('');
    }
    document.getElementById('filter-date').addEventListener('change',renderTable);
    document.getElementById('filter-branch').addEventListener('change',renderTable);

    function openEdit(id){
      editingRecord=allData.find(r=>r.__backendId===id);if(!editingRecord)return;
      document.getElementById('edit-date').value=editingRecord.date;
      document.getElementById('edit-branch').value=editingRecord.branch;
      FUELS.forEach(f=>{document.getElementById('edit-fuel-'+f.key).value=Number(editingRecord[f.key])||0;});
      document.getElementById('edit-modal').classList.remove('hidden');
    }
    function closeEditModal(){document.getElementById('edit-modal').classList.add('hidden');editingRecord=null;}
    document.getElementById('edit-form').addEventListener('submit',async(e)=>{
      e.preventDefault();
      const updated={...editingRecord, date:document.getElementById('edit-date').value, branch:document.getElementById('edit-branch').value};
      FUELS.forEach(f=>{updated[f.key]=parseFloat(document.getElementById('edit-fuel-'+f.key).value)||0;});
      await window.dataSdk.update(updated);
      closeEditModal();
    });

    function openDelete(id){deletingRecord=allData.find(r=>r.__backendId===id);document.getElementById('delete-modal').classList.remove('hidden');}
    function closeDeleteModal(){document.getElementById('delete-modal').classList.add('hidden');deletingRecord=null;}
    async function confirmDelete(){if(deletingRecord)await window.dataSdk.delete(deletingRecord);closeDeleteModal();}

    function exportCSV(){
      const headers=['วันที่','สาขา',...FUELS.map(f=>f.label)];
      const rows=allData.map(r=>[r.date,r.branch,...FUELS.map(f=>Number(r[f.key])||0)]);
      const csv='\uFEFF'+[headers,...rows].map(r=>r.join(',')).join('\n');
      const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
      const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='stock_data.csv';a.click();
    }

    lucide.createIcons();
  </script>
